    { "match": "workshop", "key": "workshop", "rank": 3, "label": "workshop", "emoji": "🛠️" },
    { "match": "boost",    "key": "boost",    "rank": 4, "label": "boost",    "emoji": "🚀" },
    { "match": "marathon", "key": "marathon", "rank": 5, "label": "marathon", "emoji": "🏃" },
    { "match": "review",   "key": "review",   "rank": 6, "label": "review",   "emoji": "🔁" }
  ],

  "other": { "label": "other", "emoji": "📄" }
